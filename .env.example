# Brevo (decisions §6a). Without BREVO_API_KEY /api/lead runs in dry-run mode, except in Vercel Production (502).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=ETF Dvojče
BREVO_REPLY_TO=
BREVO_PLAN_LIST_ID=
BREVO_NEWSLETTER_LIST_ID=
# A preview deploy without BREVO_API_KEY runs in dry-run mode and sends nothing.
SITE_URL=http://localhost:4321
# Umami Cloud website ID (decisions §11). Set only in Vercel's Production environment; empty = no analytics, track() logs in dev.
PUBLIC_UMAMI_WEBSITE_ID=

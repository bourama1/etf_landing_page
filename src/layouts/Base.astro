---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  ogTitle?: string;
  ogDescription?: string;
}
const { title, description, noindex = false, ogTitle = title, ogDescription = description } = Astro.props;
---

<!doctype html>
<html lang="cs" data-variant="a">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="website" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/archivo-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/archivo-latin-ext.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/archivo-wide-800.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Runs before paint: enables the island UI and picks the hero by ad (decisions §4, §15 #14).
      var c = new URLSearchParams(location.search).get('utm_content') || '';
      document.documentElement.className = 'js';
      document.documentElement.dataset.variant = c.indexOf('ad_b_') === 0 ? 'b' : 'a';
    </script>
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/analytics.ts';
    </script>
  </body>
</html>

---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content="Které evropské ETF koupit místo VOO?" />
    <meta property="og:description" content="Ťuknete na americké ETF a uvidíte jeho evropské dvojče. Zdarma, nejsme broker." />
    <meta property="og:type" content="website" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preload" href="/fonts/archivo-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/archivo-latin-ext.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Runs before paint: enables the island UI and picks the hero by ad (decisions §4, §15 #14).
      var c = new URLSearchParams(location.search).get('utm_content') || '';
      document.documentElement.className = 'js';
      document.documentElement.dataset.variant = c.indexOf('ad_b_') === 0 ? 'b' : 'a';
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

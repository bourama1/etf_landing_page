---
// No-JS landing after a failed send (303 from /api/lead: server error, oversized or malformed body). page.md §2 "Server error".
import Base from '../layouts/Base.astro';
import FinalForm from '../components/FinalForm.astro';
import Footer from '../components/Footer.astro';
---

<Base title="Plán se nepodařilo odeslat | ETF Dvojče" description="Formulář se nepodařilo odeslat." noindex>
  <main class="page">
    <section data-section="send_error">
      <p class="brand">ETF Dvojče</p>
      <h1>Plán se nepodařilo odeslat. Zkuste to prosím za chvíli znovu.</h1>
    </section>
    <section data-section="final"><FinalForm /></section>
  </main>
  <Footer />
</Base>

---
// Section order: decisions §8.
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Tool from '../components/Tool.astro';
import NoJsTable from '../components/NoJsTable.astro';
import WhyBlocked from '../components/WhyBlocked.astro';
import PlanContents from '../components/PlanContents.astro';
import About from '../components/About.astro';
import Faq from '../components/Faq.astro';
import FinalForm from '../components/FinalForm.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Evropské dvojče vašeho ETF | ETF Dvojče"
  description="Broker vám neprodá VOO? Najděte evropské ETF se stejným indexem a spočítejte si poplatky v korunách. U každého čísla zdroj a datum."
  ogTitle="Které evropské ETF koupit místo VOO?"
  ogDescription="Ťuknete na americké ETF a uvidíte jeho evropské dvojče. Zdarma, nejsme broker."
>
  <main class="page">
    <section data-section="hero"><Hero /></section>
    <section data-section="tool" id="nastroj"><Tool /><NoJsTable /></section>
    <section data-section="why"><WhyBlocked /></section>
    <section data-section="plan"><PlanContents /></section>
    <section data-section="about"><About /></section>
    <section data-section="faq"><Faq /></section>
    <section data-section="final" id="formular"><FinalForm /></section>
  </main>
  <Footer />
</Base>

<script>
  import '../scripts/funnel.ts';
</script>
